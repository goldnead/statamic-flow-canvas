# What an installing site does not need to download. NOTE: `/resources/js` is
# deliberately NOT ignored — it is the package. The hosts install it straight
# from the vendor directory as `@goldnead/flow-canvas`.

/.github            export-ignore
/tests              export-ignore
/art                export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
/addon-lint.json    export-ignore
/vitest.config.js   export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
